{%- doc -%}
  Energieeffizienzklasse (Block). Markup und Styles liegen in snippets/energy-class.liquid,
  damit Produktkarte, Produktseite und Suchvorschau dieselbe Darstellung verwenden.
{%- enddoc -%}

{%- render 'energy-class',
  product: closest.product,
  size: block.settings.size,
  show_datasheet: block.settings.show_datasheet,
  show_marker: true,
  attributes: block.shopify_attributes
-%}


{% schema %}
{
  "name": "Energieeffizienzklasse",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "Größe",
      "options": [
        { "value": "small", "label": "Klein (Produktkarte)" },
        { "value": "regular", "label": "Normal (Produktseite)" }
      ],
      "default": "regular"
    },
    {
      "type": "checkbox",
      "id": "show_datasheet",
      "label": "Link zum Produktdatenblatt zeigen",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Energieeffizienzklasse"
    }
  ]
}
{% endschema %}
