{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {boolean} [field] - Render as a visible search field on large screens (opens the search modal).

  @example
  {% render 'search', style: 'default', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if field %} search-action--field{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      on:click="#search-modal/showDialog"
      class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.search' | t }}
      </span>

      <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
      {%- if field -%}
        <span class="search-action__placeholder" aria-hidden="true">{{ 'lamp.search.placeholder' | t }}</span>
      {%- endif -%}
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text {
      margin-inline: 0;
    }
  }

  /* Lampenshop: sichtbares Suchfeld ab 990px, darunter weiterhin das Icon */
  .search-action__placeholder {
    display: none;
  }

  @media screen and (min-width: 990px) {
    [data-menu-style='menu'] .header__column .search-action.search-action--field {
      margin-inline: 0 var(--gap-xs);
    }

    [data-menu-style='menu'] .search-action--field .header-actions__action {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: var(--gap-xs);
      width: clamp(180px, 18vw, 260px);
      height: 40px;
      padding-inline: var(--padding-sm);
      border: 1px solid var(--color-line);
      border-radius: var(--search-border-radius);
      color: var(--color-foreground-muted);
      font-size: 0.875rem;
      cursor: text;
      transition: border-color var(--animation-speed) var(--animation-easing);
    }

    [data-menu-style='menu'] .search-action--field .header-actions__action:hover,
    [data-menu-style='menu'] .search-action--field .header-actions__action:focus-visible {
      border-color: var(--color-foreground);
    }

    [data-menu-style='menu'] .search-action--field .svg-wrapper {
      flex-shrink: 0;
      width: var(--icon-size-xs);
      height: var(--icon-size-xs);
    }

    [data-menu-style='menu'] .search-action--field .search-action__placeholder {
      display: block;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
  }
{% endstylesheet %}
