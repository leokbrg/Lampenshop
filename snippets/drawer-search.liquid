{%- doc -%}
  Suchfeld oben im mobilen Menü-Drawer. Öffnet die Suchvorschau (Dialog #search-modal).

  @param {boolean} [enabled] - Nur rendern, wenn die Suche im Header aktiv ist

  @example
  {% render 'drawer-search', enabled: section.settings.show_search %}
{%- enddoc -%}

{%- if enabled -%}
  <div class="menu-drawer__search">
    <button
      type="button"
      class="menu-drawer__search-button button-unstyled"
      on:click="#search-modal/showDialog"
      aria-haspopup="dialog"
      aria-label="{{ 'content.search_input_label' | t }}"
    >
      <span class="svg-wrapper">{{ 'icon-search.svg' | inline_asset_content }}</span>
      <span aria-hidden="true">{{ 'lamp.search.placeholder' | t }}</span>
    </button>
  </div>
{%- endif -%}

{% stylesheet %}
  .menu-drawer__search {
    padding: var(--padding-lg) var(--drawer-padding) var(--padding-xs);
  }

  @media screen and (min-width: 750px) {
    /* ab Tablet liegt die Suche als Icon im Header, oben im Drawer sitzt dort der Schließen-Button */
    .menu-drawer__search {
      display: none;
    }
  }

  .menu-drawer__search-button {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    width: 100%;
    min-height: var(--minimum-touch-target);
    padding-inline: var(--padding-sm);
    border: 1px solid var(--color-line);
    border-radius: var(--style-border-radius-inputs);
    color: var(--color-foreground-muted);
    font-size: 1rem;
    text-align: start;
    cursor: text;
  }

  .menu-drawer__search-button .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
  }
{% endstylesheet %}
